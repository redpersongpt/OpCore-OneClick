{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpCore-OneClick",
  "version": "6.0.0",
  "identifier": "com.redpersongpt.opcore-oneclick",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "OpCore-OneClick",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "OpenCore EFI builder and macOS installer USB creator",
    "homepage": "https://github.com/redpersongpt/OpCore-OneClick",
    "license": "Apache-2.0",
    "copyright": "Copyright 2026 OpCore-OneClick contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["util-linux", "fdisk", "dosfstools", "pkexec | policykit-1"],
        "recommends": ["pciutils", "udisks2"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "shell": {
      "open": "https://[^\\s]+"
    }
  }
}
